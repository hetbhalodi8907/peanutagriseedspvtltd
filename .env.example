# Enquiry email delivery (Phase 6). Copy to .env.local (never commit real values).
# Full setup guide: docs/INQUIRY-EMAIL-SETUP.md

# Resend API key (server-side only). Create one at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Sender. Must be an address on a domain verified in Resend, e.g.
#   PEANUT AGRI SEEDS Website <enquiries@your-verified-domain.com>
# For first tests only, Resend's shared sender works if the Resend account itself
# is registered to peanutagriseeds@gmail.com:
#   PEANUT AGRI SEEDS Website <onboarding@resend.dev>
INQUIRY_FROM_EMAIL=PEANUT AGRI SEEDS Website <enquiries@your-verified-domain.com>

# Destination. Must be exactly this address; any other value is rejected.
INQUIRY_TO_EMAIL=peanutagriseeds@gmail.com

# Public site origin, read at BUILD time for canonical URLs, social tags, sitemap and
# structured data. Leave unset until the real domain exists (see docs/LAUNCH-READINESS.md).
# SITE_URL=https://www.your-company-domain.in

# Number of proxies in front of the app that append to X-Forwarded-For (default 1).
# Vercel or one reverse proxy: 1. CDN in front of a reverse proxy: 2.
# TRUSTED_PROXY_HOPS=1

# Optional, for automated tests only: points the server at a local mock provider.
# RESEND_API_BASE_URL=http://127.0.0.1:3201
